# AWS credentials (for local development)
# In production (App Runner), use IAM roles instead
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-west-2

# GetMyCourt Bot Configuration
GETMYCOURT_LAMBDA_NAME=getmycourt-x86
GETMYCOURT_SCHEDULE_NAME=getmycourt-schedule

# GetMyTeeTime Bot Configuration
GETMYTEETIME_LAMBDA_NAME=getmyteetime-x86
GETMYTEETIME_SCHEDULE_NAME=getmyteetime-schedule
# Optional scheduler group name (defaults to EventBridge Scheduler "default" group when unset)
GETMYTEETIME_SCHEDULE_GROUP=

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
